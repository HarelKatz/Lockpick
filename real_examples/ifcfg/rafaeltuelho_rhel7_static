* cat /etc/sysconfig/network-scripts/ifcfg-eth0
```
DEVICE="eth0"
BOOTPROTO=none
BOOTPROTOv6="dhcp"
ONBOOT="yes"
TYPE="Ethernet"
USERCTL="yes"
IPV6INIT=no
PERSISTENT_DHCLIENT="1"
NM_CONTROLLED="yes"
IPADDR=x.x.x.x
PREFIX=32
GATEWAY=y.y.y.y
DNS1=y.y.y.y
DEFROUTE=yes
IPV4_FAILURE_FATAL=yes
NAME="System eth0"
UUID=5fb06bd0-0bb0-7ffb-45f1-d6edd65f3e03
```

* to see the ifcs status
```
nmcli dev status
```

* to edit with NetworkManager CLI
```
yum install NetworkManager-tui
nmtui edit <ifc-name>
systemctl restart network.service
```

* to set the hostname
```
hostnamectl set-hostname myserver.example.com
```