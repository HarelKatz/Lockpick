# Sample ifcfg-eth0 file
TYPE=Ethernet
DEVICE=eth0
BOOTPROTO=static
ONBOOT=yes
IPADDR=192.168.1.10
PREFIX=24
NETMASK=255.255.255.0
GATEWAY=192.168.1.1

# Aliases
IPADDR2=10.0.0.5
PREFIX2=24
IPADDR3=10.1.0.5
PREFIX3=24

# IPv6
IPV6INIT=yes
IPV6ADDR="2001:db8::1/64"
IPV6ADDR_SECONDARIES="2001:db8::2/64 2001:db8::3/64"
IPV6_DEFAULTGW=2001:db8::ffff
